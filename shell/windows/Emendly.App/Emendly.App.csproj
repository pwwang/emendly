<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Emendly.App</AssemblyName>
    <RootNamespace>Emendly.App</RootNamespace>
    <Version>0.1.1</Version>
    <FileVersion Condition="'$(FileVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '[-+].*$', '')).0</FileVersion>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
    <ApplicationIcon>Assets\emendly.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Emendly.Capture\Emendly.Capture.csproj" />
    <ProjectReference Include="..\Emendly.Core\Emendly.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\emendly.ico" />
    <Content Include="Assets\emendly.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\emendly-32.png" />
    <Resource Include="Assets\emendly-256.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="app-rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
