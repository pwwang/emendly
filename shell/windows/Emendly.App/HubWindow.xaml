<Window x:Class="Emendly.App.HubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emendly Hub"
        Icon="/Assets/emendly.ico"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#141419"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI"
        FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="CardBrush" Color="#1C1D25" />
    <SolidColorBrush x:Key="BorderBrushDark" Color="#2A2C38" />
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#13141B" />
      <Setter Property="Foreground" Value="#F3F4F6" />
      <Setter Property="CaretBrush" Value="#F3F4F6" />
      <Setter Property="BorderBrush" Value="#2A2C38" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,3,0,8" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#13141B" />
      <Setter Property="Foreground" Value="#F3F4F6" />
      <Setter Property="BorderBrush" Value="#2A2C38" />
      <Setter Property="Padding" Value="7,5" />
      <Setter Property="Margin" Value="0,3,0,8" />
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#13141B" />
      <Setter Property="Foreground" Value="#F3F4F6" />
      <Setter Property="BorderBrush" Value="#2A2C38" />
      <Setter Property="Padding" Value="5" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#232530" />
      <Setter Property="Foreground" Value="#F3F4F6" />
      <Setter Property="BorderBrush" Value="#2A2C38" />
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#9CA3AF" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#1C1D25" />
      <Setter Property="BorderBrush" Value="#2A2C38" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9CA3AF" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,3,0,2" />
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="228" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#0F1015" BorderBrush="#2A2C38" BorderThickness="0,0,1,0" Padding="14,16">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="4,0,4,18">
          <TextBlock Text="Emendly" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Local Writing Suite · BYOK" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <TextBlock x:Name="SidebarEngineStatus" Text="Engine: locating..." FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="2,0,2,2" />
          <TextBlock x:Name="SidebarApiKeyStatus" Text="API Key: checking..." FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="2,0,2,0" />
        </StackPanel>
        <StackPanel>
          <Button x:Name="NavPrompts" Content="Saved Prompts" Style="{StaticResource NavButton}" Click="OnNavClick" Tag="prompts" />
          <Button x:Name="NavHistory" Content="History" Style="{StaticResource NavButton}" Click="OnNavClick" Tag="history" />
          <Button x:Name="NavGlossary" Content="Glossary" Style="{StaticResource NavButton}" Click="OnNavClick" Tag="glossary" />
          <Button x:Name="NavProfiles" Content="App Profiles" Style="{StaticResource NavButton}" Click="OnNavClick" Tag="profiles" />
          <Button x:Name="NavChains" Content="Chains &amp; Batch" Style="{StaticResource NavButton}" Click="OnNavClick" Tag="chains" />
          <Button x:Name="NavTones" Content="Tone Presets" Style="{StaticResource NavButton}" Click="OnNavClick" Tag="tones" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="20">
      <Grid x:Name="ViewPrompts" Visibility="Visible">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,12"><TextBlock Text="Saved Prompts" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Manage reusable prompts and test them with the local engine." Foreground="#9CA3AF" /></StackPanel>
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
          <DockPanel>
            <TextBox x:Name="PromptSearchBox" DockPanel.Dock="Top" ToolTip="Filter saved prompts" TextChanged="OnPromptSearchChanged" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"><Button Content="New" Click="OnPromptNewClick" /><Button Content="Delete" Click="OnPromptDeleteClick" /></StackPanel>
            <ListBox x:Name="PromptsListBox" SelectionChanged="OnPromptSelectionChanged" />
          </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Name" Style="{StaticResource Label}" /><TextBox x:Name="PromptNameBox" />
                <TextBlock Text="Hotkey" Style="{StaticResource Label}" /><TextBox x:Name="PromptHotkeyBox" />
                <TextBlock Text="Description" Style="{StaticResource Label}" /><TextBox x:Name="PromptDescriptionBox" />
                <TextBlock Text="System Prompt" Style="{StaticResource Label}" /><TextBox x:Name="PromptSystemBox" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />
                <TextBlock Text="User Template" Style="{StaticResource Label}" /><TextBox x:Name="PromptTemplateBox" AcceptsReturn="True" TextWrapping="Wrap" Height="54" />
                <StackPanel Orientation="Horizontal"><CheckBox x:Name="PromptIncludeContextCheck" Content="Include context" Margin="0,0,16,8" /><CheckBox x:Name="PromptRequiresSelectionCheck" Content="Requires selection" IsChecked="True" Margin="0,0,16,8" /></StackPanel>
                <StackPanel Orientation="Horizontal"><Button Content="Save Prompt" Click="OnPromptSaveClick" /><TextBlock x:Name="PromptStatusText" Foreground="#9CA3AF" VerticalAlignment="Center" /></StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Quick Test" FontWeight="SemiBold" />
                <TextBox x:Name="PromptTestInputBox" AcceptsReturn="True" TextWrapping="Wrap" Height="68" Text="Hi team, just wanted to quickly circle back around on the Q4 rollout timeline and make sure we are aligned before Friday." />
                <StackPanel Orientation="Horizontal"><Button x:Name="PromptQuickRunButton" Content="Run Prompt" Click="OnPromptQuickRunClick" /><Button Content="Copy Output" Click="OnPromptCopyOutputClick" /><TextBlock x:Name="PromptRunStatusText" Foreground="#9CA3AF" VerticalAlignment="Center" /></StackPanel>
                <TextBox x:Name="PromptTestOutputBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="86" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid x:Name="ViewHistory" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12"><TextBlock Text="History" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Local-only run history stored on this device." Foreground="#9CA3AF" /></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="HistoryPauseButton" Content="Pause Recording" Click="OnHistoryTogglePauseClick" /><Button Content="Clear All" Click="OnHistoryClearAllClick" /></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBox x:Name="HistorySearchBox" Width="280" TextChanged="OnHistorySearchChanged" /><ComboBox x:Name="HistoryActionFilterCombo" Width="160" SelectionChanged="OnHistoryActionFilterChanged" /></StackPanel>
          </DockPanel>
        </Border>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}"><ListBox x:Name="HistoryListBox" SelectionChanged="OnHistorySelectionChanged" /></Border>
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
              <TextBlock x:Name="HistoryDetailMeta" DockPanel.Dock="Top" Text="Select a history entry to inspect." Foreground="#9CA3AF" TextWrapping="Wrap" />
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Copy Output" Click="OnHistoryCopyOutputClick" /><Button Content="Delete Entry" Click="OnHistoryDeleteEntryClick" /><TextBlock x:Name="HistoryStatusText" Foreground="#9CA3AF" VerticalAlignment="Center" /></StackPanel>
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Input" Style="{StaticResource Label}" /><TextBox Grid.Row="1" x:Name="HistoryDetailInputBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" />
                <TextBlock Grid.Row="2" Text="Output" Style="{StaticResource Label}" /><TextBox Grid.Row="3" x:Name="HistoryDetailOutputBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" />
              </Grid>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
      <Grid x:Name="ViewGlossary" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12"><TextBlock Text="Glossary" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Manage terminology and do-not-translate terms." Foreground="#9CA3AF" /></StackPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="290" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"><Button Content="New Term" Click="OnGlossaryNewClick" /><Button Content="Delete" Click="OnGlossaryDeleteClick" /></StackPanel><ListBox x:Name="GlossaryListBox" SelectionChanged="OnGlossarySelectionChanged" /></DockPanel></Border>
          <ScrollViewer Grid.Column="2"><StackPanel>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Source Term" Style="{StaticResource Label}" /><TextBox x:Name="GlossarySourceBox" />
              <TextBlock Text="Target Replacement" Style="{StaticResource Label}" /><TextBox x:Name="GlossaryTargetBox" />
              <TextBlock Text="Language Filter" Style="{StaticResource Label}" /><TextBox x:Name="GlossaryLanguageBox" />
              <TextBlock Text="Note" Style="{StaticResource Label}" /><TextBox x:Name="GlossaryNoteBox" />
              <StackPanel Orientation="Horizontal"><CheckBox x:Name="GlossaryDntCheck" Content="Do not translate" Checked="OnGlossaryDntChanged" Unchecked="OnGlossaryDntChanged" Margin="0,0,18,8" /><CheckBox x:Name="GlossaryEnabledCheck" Content="Enabled" IsChecked="True" Margin="0,0,18,8" /></StackPanel>
              <StackPanel Orientation="Horizontal"><Button Content="Save Term" Click="OnGlossarySaveClick" /><TextBlock x:Name="GlossaryStatusText" Foreground="#9CA3AF" VerticalAlignment="Center" /></StackPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Compiled Terminology Rules Preview" FontWeight="SemiBold" /><TextBox x:Name="GlossaryPreviewLangBox" ToolTip="Preview language" TextChanged="OnGlossaryPreviewLangChanged" /><TextBox x:Name="GlossaryPreviewBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="140" /></StackPanel></Border>
          </StackPanel></ScrollViewer>
        </Grid>
      </Grid>
      <Grid x:Name="ViewProfiles" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12"><TextBlock Text="App Profiles" FontSize="20" FontWeight="SemiBold" /><TextBlock x:Name="ProfilesPathText" Foreground="#9CA3AF" /></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="Application executable" Style="{StaticResource Label}" /><ComboBox x:Name="ProfileAppCombo" IsEditable="True" />
          <TextBlock Text="Capture Strategy" Style="{StaticResource Label}" /><ComboBox x:Name="ProfileStrategyCombo" />
          <StackPanel Orientation="Horizontal"><Button Content="Refresh Apps" Click="OnProfileRefreshAppsClick" /><Button Content="Add / Update" Click="OnProfileAddClick" /></StackPanel>
          <TextBlock x:Name="ProfilesStatusText" Foreground="#9CA3AF" />
        </StackPanel></Border>
        <Border Grid.Row="2" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"><Button Content="Remove Selected" Click="OnProfileRemoveClick" /><Button Content="Save Rules" Click="OnProfileSaveClick" /></StackPanel><ListBox x:Name="ProfilesListBox" SelectionChanged="OnProfileSelectionChanged" /></DockPanel></Border>
      </Grid>
      <Grid x:Name="ViewChains" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12"><TextBlock Text="Chains &amp; Batch" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Run action chains and blank-line-preserving paragraph batches." Foreground="#9CA3AF" /></StackPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}"><ScrollViewer><StackPanel>
            <TextBlock Text="Action Chains" FontWeight="SemiBold" /><ListBox x:Name="ChainsListBox" Height="100" SelectionChanged="OnChainSelectionChanged" />
            <StackPanel Orientation="Horizontal"><Button Content="New Chain" Click="OnChainNewClick" /><Button Content="Save Chain" Click="OnChainSaveClick" /><Button Content="Delete" Click="OnChainDeleteClick" /></StackPanel>
            <TextBlock Text="Chain Name" Style="{StaticResource Label}" /><TextBox x:Name="ChainNameBox" />
            <TextBlock Text="Steps" Style="{StaticResource Label}" /><ListBox x:Name="ChainStepsListBox" Height="80" />
            <ComboBox x:Name="ChainStepActionCombo" /><TextBox x:Name="ChainStepToneBox" ToolTip="Optional tone" /><TextBox x:Name="ChainStepLangBox" ToolTip="Optional target language" />
            <StackPanel Orientation="Horizontal"><Button Content="Add Step" Click="OnChainAddStepClick" /><Button Content="Remove Step" Click="OnChainRemoveStepClick" /></StackPanel>
            <TextBlock Text="Sample Input" Style="{StaticResource Label}" /><TextBox x:Name="ChainInputBox" AcceptsReturn="True" TextWrapping="Wrap" Height="66" Text="We need to ship the release by Friday so customers can start testing." />
            <StackPanel Orientation="Horizontal"><Button x:Name="ChainRunButton" Content="Run Chain" Click="OnChainRunClick" /><Button Content="Copy Output" Click="OnChainCopyOutputClick" /><TextBlock x:Name="ChainStatusText" Foreground="#9CA3AF" VerticalAlignment="Center" TextWrapping="Wrap" /></StackPanel>
            <TextBox x:Name="ChainOutputBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
          </StackPanel></ScrollViewer></Border>
          <Border Grid.Column="2" Style="{StaticResource Card}"><ScrollViewer><StackPanel>
            <TextBlock Text="Paragraph Batch Runner" FontWeight="SemiBold" />
            <TextBlock Text="Action / Mode" Style="{StaticResource Label}" /><ComboBox x:Name="BatchActionCombo" />
            <TextBlock Text="Target Language (optional)" Style="{StaticResource Label}" /><TextBox x:Name="BatchLangBox" />
            <TextBlock Text="Multi-Paragraph Input (blank lines preserved)" Style="{StaticResource Label}" /><TextBox x:Name="BatchInputBox" AcceptsReturn="True" TextWrapping="Wrap" Height="150" Text="Their going too launch the beta next week.&#x0a;&#x0a;Please let us no if you spot any issues with the installer." />
            <StackPanel Orientation="Horizontal"><Button x:Name="BatchRunButton" Content="Run Batch" Click="OnBatchRunClick" /><Button x:Name="BatchCancelButton" Content="Cancel" Click="OnBatchCancelClick" IsEnabled="False" /><Button Content="Copy Output" Click="OnBatchCopyOutputClick" /></StackPanel>
            <ProgressBar x:Name="BatchProgressBar" Height="8" Minimum="0" Maximum="100" Background="#13141B" Foreground="#2563EB" Margin="0,0,0,6" />
            <TextBlock x:Name="BatchStatusText" Text="Idle" Foreground="#9CA3AF" />
            <TextBlock Text="Batch Output" Style="{StaticResource Label}" /><TextBox x:Name="BatchOutputBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="160" />
          </StackPanel></ScrollViewer></Border>
        </Grid>
      </Grid>
      <Grid x:Name="ViewTones" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12"><TextBlock Text="Tone Presets" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Manage reusable tone instructions." Foreground="#9CA3AF" /></StackPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"><Button Content="New Tone" Click="OnToneNewClick" /><Button Content="Delete" Click="OnToneDeleteClick" /></StackPanel><ListBox x:Name="TonesListBox" SelectionChanged="OnToneSelectionChanged" /></DockPanel></Border>
          <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
            <TextBlock Text="Preset Name" Style="{StaticResource Label}" /><TextBox x:Name="ToneNameBox" />
            <TextBlock Text="Description" Style="{StaticResource Label}" /><TextBox x:Name="ToneDescriptionBox" />
            <TextBlock Text="Tone Instructions" Style="{StaticResource Label}" /><TextBox x:Name="ToneInstructionsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="180" />
            <StackPanel Orientation="Horizontal"><Button Content="Save Tone Preset" Click="OnToneSaveClick" /><TextBlock x:Name="ToneStatusText" Foreground="#9CA3AF" VerticalAlignment="Center" /></StackPanel>
          </StackPanel></Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
