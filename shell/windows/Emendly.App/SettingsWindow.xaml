<Window x:Class="Emendly.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emendly Settings"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E24"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI"
        FontSize="13">
  <StackPanel Margin="18">
    <TextBlock Text="Base URL" Foreground="#D1D5DB" Margin="0,0,0,4" />
    <TextBox x:Name="BaseUrlBox"
             Background="#141419"
             Foreground="#F3F4F6"
             CaretBrush="#F3F4F6"
             BorderBrush="#3B3B48"
             Padding="8,6"
             Margin="0,0,0,12" />

    <TextBlock Text="Model" Foreground="#D1D5DB" Margin="0,0,0,4" />
    <TextBox x:Name="ModelBox"
             Background="#141419"
             Foreground="#F3F4F6"
             CaretBrush="#F3F4F6"
             BorderBrush="#3B3B48"
             Padding="8,6"
             Margin="0,0,0,12" />

    <TextBlock Text="Global Hotkey (e.g. Ctrl+Alt+E)" Foreground="#D1D5DB" Margin="0,0,0,4" />
    <TextBox x:Name="HotkeyBox"
             Background="#141419"
             Foreground="#F3F4F6"
             CaretBrush="#F3F4F6"
             BorderBrush="#3B3B48"
             Padding="8,6"
             Margin="0,0,0,12" />

    <Border Background="#141419"
            BorderBrush="#2C2C36"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10,8"
            Margin="0,0,0,12">
      <StackPanel>
        <TextBlock x:Name="EngineStatusText" Foreground="#9CA3AF" FontSize="12" />
        <TextBlock x:Name="ApiKeyStatusText" Foreground="#9CA3AF" FontSize="12" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <TextBlock x:Name="ValidationText"
               Foreground="#F87171"
               FontSize="12"
               TextWrapping="Wrap"
               Visibility="Collapsed"
               Margin="0,0,0,10" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel"
              Width="84"
              Padding="8,6"
              Margin="0,0,8,0"
              IsCancel="True"
              Background="#2A2A34"
              Foreground="#F3F4F6"
              BorderBrush="#3B3B48"
              Click="OnCancelClick" />
      <Button Content="Save"
              Width="84"
              Padding="8,6"
              IsDefault="True"
              Background="#2563EB"
              Foreground="#FFFFFF"
              BorderBrush="#3B82F6"
              Click="OnSaveClick" />
    </StackPanel>
  </StackPanel>
</Window>
