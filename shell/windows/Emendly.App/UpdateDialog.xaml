<Window x:Class="Emendly.App.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emendly Update"
        Icon="/Assets/emendly.ico"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#141419"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI"
        FontSize="13"
        Loaded="OnWindowLoaded"
        PreviewKeyDown="OnWindowPreviewKeyDown">
  <Window.Resources>
    <Style x:Key="DarkScrollBarStyle" TargetType="ScrollBar">
      <Setter Property="Width" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="#3A3F4E" CornerRadius="5" Margin="2,4" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}" />

    <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button">
      <Setter Property="MinWidth" Value="76" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Background" Value="#1E1E26" />
      <Setter Property="Foreground" Value="#F3F4F6" />
      <Setter Property="BorderBrush" Value="#3B3B48" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#2A2A36" />
          <Setter Property="BorderBrush" Value="#4E5873" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="#3B82F6" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.5" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button">
      <Setter Property="MinWidth" Value="128" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#3B82F6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1D4ED8" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="#93C5FD" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.5" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <StackPanel Margin="20">
    <TextBlock Text="A new version of Emendly is available"
               FontSize="15"
               FontWeight="SemiBold"
               Foreground="#F3F4F6" />

    <TextBlock x:Name="VersionTransitionText"
               Foreground="#93C5FD"
               FontSize="12"
               Margin="0,4,0,12" />

    <TextBlock Text="Release notes"
               Foreground="#9CA3AF"
               FontSize="12"
               Margin="0,0,0,6" />

    <Border Background="#1E1E26"
            BorderBrush="#2C2C36"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12,10"
            Height="200">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="ReleaseNotesText"
                   Foreground="#D1D5DB"
                   FontSize="12"
                   LineHeight="18"
                   TextWrapping="Wrap" />
      </ScrollViewer>
    </Border>

    <StackPanel x:Name="ProgressPanel"
                Visibility="Collapsed"
                Margin="0,12,0,0">
      <TextBlock x:Name="ProgressStatusText"
                 Foreground="#9CA3AF"
                 FontSize="12"
                 Margin="0,0,0,6" />
      <ProgressBar x:Name="DownloadProgressBar"
                   Height="6"
                   Minimum="0"
                   Maximum="100"
                   Background="#1E1E26"
                   Foreground="#2563EB"
                   BorderBrush="#2C2C36"
                   BorderThickness="1" />
    </StackPanel>

    <TextBlock x:Name="ErrorText"
               Foreground="#F87171"
               FontSize="12"
               TextWrapping="Wrap"
               Visibility="Collapsed"
               Margin="0,10,0,0" />

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button x:Name="LaterButton"
              Content="Later"
              Margin="0,0,8,0"
              Style="{StaticResource DialogSecondaryButtonStyle}"
              Click="OnLaterClick" />
      <Button x:Name="OpenReleasePageButton"
              Content="Open Release Page"
              Margin="0,0,8,0"
              Style="{StaticResource DialogSecondaryButtonStyle}"
              Click="OnOpenReleasePageClick" />
      <Button x:Name="DownloadButton"
              Content="Download &amp; Install"
              IsDefault="True"
              Style="{StaticResource DialogPrimaryButtonStyle}"
              Click="OnDownloadClick" />
    </StackPanel>
  </StackPanel>
</Window>
