<Window x:Class="Emendly.App.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emendly"
        Width="380"
        SizeToContent="Height"
        MaxHeight="420"
        MinHeight="140"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="True"
        Focusable="True"
        ShowInTaskbar="False"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Deactivated="OnWindowDeactivated"
        SizeChanged="OnWindowSizeChanged"
        FontFamily="Segoe UI"
        FontSize="13">
  <Window.Resources>
    <Geometry x:Key="ContextIconGeometry">M 3.5,3 L 1.5,3 L 1.5,13 L 3.5,13 M 12.5,3 L 14.5,3 L 14.5,13 L 12.5,13 M 11,4 L 7,4 A 2,2 0 0 0 7,8 L 8,8 M 8,4 L 8,12.5 M 10,4 L 10,12.5</Geometry>
    <Geometry x:Key="ContextSlashGeometry">M 2,14 L 14,2</Geometry>
    <Geometry x:Key="GlobeIconGeometry">M 4.5,1 A 3.5,3.5 0 1 0 4.5,8 A 3.5,3.5 0 1 0 4.5,1 M 1,4.5 L 8,4.5 M 4.5,1 A 1.75,3.5 0 0 0 4.5,8 A 1.75,3.5 0 0 0 4.5,1</Geometry>
    <Geometry x:Key="LockIconGeometry">M 3.5,5 L 3.5,3.5 A 2,2 0 0 1 7.5,3.5 L 7.5,5 M 2,5 L 9,5 L 9,10 L 2,10 Z</Geometry>

        <Style x:Key="ContextChipButtonStyle" TargetType="Button">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Background" Value="#263148" />
      <Setter Property="Foreground" Value="#DBEAFE" />
      <Setter Property="BorderBrush" Value="#3B82F6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#31405E" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#1B1D26" />
          <Setter Property="BorderBrush" Value="#333544" />
          <Setter Property="Foreground" Value="#8C93A6" />
          <Setter Property="Cursor" Value="Arrow" />
        </Trigger>
      </Style.Triggers>
    </Style>

        <Style x:Key="PanelScrollBarStyle" TargetType="ScrollBar">
      <Setter Property="Width" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="#3A3F4E" CornerRadius="5" Margin="2,4" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="OptionIconButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Width="18" Height="18" Background="Transparent">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="4"
                      SnapsToDevicePixels="True" />
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="False" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#32384A" />
          <Setter Property="BorderBrush" Value="#4E5873" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Background" Value="#28354E" />
          <Setter Property="BorderBrush" Value="#60A5FA" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="Opacity" Value="0.5" />
          <Setter Property="Cursor" Value="Arrow" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource PanelScrollBarStyle}" />

    <Style x:Key="EditableInputBoxStyle" TargetType="TextBox">
      <Setter Property="Background" Value="#1B1B22" />
      <Setter Property="Foreground" Value="#F3F4F6" />
      <Setter Property="CaretBrush" Value="#F3F4F6" />
      <Setter Property="BorderBrush" Value="#2A2A34" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost"
                            Focusable="False"
                            HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="#3B82F6" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ReadOnlyOutputBoxStyle" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#D1D5DB" />
      <Setter Property="CaretBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="IsReadOnlyCaretVisible" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost"
                          Focusable="False"
                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Background="#1E1E24"
          BorderBrush="#383846"
          BorderThickness="1"
          CornerRadius="10"
          Margin="8"
          Padding="12">
    <Border.Effect>
      <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.45" Color="#000000" />
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Mode line header -->
      <Grid Grid.Row="0" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="ModeLineText"
                   Foreground="#F9FAFB"
                   FontWeight="SemiBold"
                   FontSize="12.5"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Border Grid.Column="1"
                Background="#2A2A35"
                CornerRadius="4"
                Padding="6,2"
                Margin="8,0,0,0"
                VerticalAlignment="Center">
          <TextBlock x:Name="ModeBadgeText"
                     Foreground="#93C5FD"
                     FontSize="11"
                     FontWeight="Medium" />
        </Border>
      </Grid>

      <!-- Long selection notice (> 4,000 chars) -->
      <Border x:Name="LongSelectionBanner"
              Grid.Row="1"
              Background="#2B2518"
              BorderBrush="#6B531B"
              BorderThickness="1"
              CornerRadius="5"
              Padding="8,4"
              Margin="0,0,0,8"
              Visibility="Collapsed">
        <TextBlock Text="Long selection: first 4,000 characters used"
                   Foreground="#FCD34D"
                   FontSize="11.5" />
      </Border>

      <!-- Stage container -->
      <Grid Grid.Row="2">

        <!-- Unsupported stage -->
        <Grid x:Name="UnsupportedPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="4,0">
            <TextBlock Text="Unsupported"
                       Foreground="#F3F4F6"
                       FontSize="14"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="UnsupportedReasonText"
                       Foreground="#9CA3AF"
                       FontSize="12.5"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Esc closes"
                       Foreground="#6B7280"
                       FontSize="11"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="Close"
                    Padding="12,4"
                    Background="#2A2A34"
                    Foreground="#E5E7EB"
                    BorderBrush="#3B3B48"
                    Click="OnCloseButtonClick" />
          </Grid>
        </Grid>

        <!-- Action menu stage -->
        <Grid x:Name="MenuPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Filter bar (expanded view) -->
          <Border x:Name="FilterBar"
                  Grid.Row="0"
                  Background="#141419"
                  BorderBrush="#3B3B48"
                  BorderThickness="1"
                  CornerRadius="5"
                  Padding="8,4"
                  Margin="0,0,0,6"
                  Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="FilterText"
                         Foreground="#E5E7EB"
                         FontSize="12"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="Backspace clears · Left back"
                         Foreground="#6B7280"
                         FontSize="11"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>

          <!-- Item list (flex slot; scrolls only when the expanded menu exceeds MaxHeight) -->
          <ScrollViewer x:Name="ActionScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Focusable="False">
            <StackPanel x:Name="ActionListPanel"
                        Focusable="True"
                        FocusVisualStyle="{x:Null}" />
          </ScrollViewer>

          <!-- Context preview line (collapsed by default) -->
          <Border x:Name="ContextPreviewBorder"
                  Grid.Row="2"
                  Background="#141419"
                  BorderBrush="#2B2C38"
                  BorderThickness="1"
                  CornerRadius="5"
                  Padding="8,4"
                  Margin="0,5,0,0"
                  Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="ContextPreviewHeaderText"
                         Foreground="#9CA3AF"
                         FontSize="11"
                         TextTrimming="CharacterEllipsis"
                         Cursor="Hand"
                         MouseLeftButtonUp="OnContextPreviewToggleClick" />
              <TextBox x:Name="ContextPreviewBox"
                       Background="#101015"
                       Foreground="#D1D5DB"
                       BorderBrush="#2C2C36"
                       BorderThickness="1"
                       FontSize="11"
                       Padding="6,4"
                       Margin="0,4,0,0"
                       MaxHeight="74"
                       IsReadOnly="True"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       Visibility="Collapsed" />
            </StackPanel>
          </Border>

          <!-- Footer hints -->
          <TextBlock x:Name="MenuHintText"
                     Grid.Row="3"
                     Foreground="#6B7280"
                     FontSize="11"
                     Margin="2,6,0,0"
                     TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Prompt input stage (Compose / Custom Prompt) -->
        <Grid x:Name="PromptPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock x:Name="PromptTitleText"
                     Grid.Row="0"
                     Foreground="#F3F4F6"
                     FontWeight="SemiBold"
                     FontSize="12"
                     Margin="0,0,0,6" />

          <TextBox x:Name="PromptInputBox"
                   Grid.Row="1"
                   Style="{StaticResource EditableInputBoxStyle}"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   AcceptsReturn="True" />

          <TextBlock x:Name="PromptErrorText"
                     Grid.Row="2"
                     Foreground="#F87171"
                     FontSize="11.5"
                     Margin="0,5,0,0"
                     Visibility="Collapsed" />

          <StackPanel x:Name="PromptContextSection"
                      Grid.Row="3"
                      Margin="0,8,0,0"
                      Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="PromptContextChipButton"
                      Style="{StaticResource ContextChipButtonStyle}"
                      Click="OnContextChipClick" />
            </StackPanel>
            <Border x:Name="PromptContextPreviewBorder"
                    Background="#141419"
                    BorderBrush="#2B2C38"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8,4"
                    Margin="0,5,0,0"
                    Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="PromptContextPreviewHeaderText"
                           Foreground="#9CA3AF"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Cursor="Hand"
                           MouseLeftButtonUp="OnContextPreviewToggleClick" />
                <TextBox x:Name="PromptContextPreviewBox"
                         Background="#101015"
                         Foreground="#D1D5DB"
                         BorderBrush="#2C2C36"
                         BorderThickness="1"
                         FontSize="11"
                         Padding="6,4"
                         Margin="0,4,0,0"
                         MaxHeight="68"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Visibility="Collapsed" />
              </StackPanel>
            </Border>
          </StackPanel>

          <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Enter runs · Shift+Enter newline · Esc closes"
                       Foreground="#6B7280"
                       FontSize="11"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
              <Button Content="Back"
                      Padding="10,4"
                      Margin="0,0,6,0"
                      Background="#2A2A34"
                      Foreground="#E5E7EB"
                      BorderBrush="#3B3B48"
                      Click="OnPromptBackClick" />
              <Button Content="Run"
                      Padding="12,4"
                      Background="#2563EB"
                      Foreground="#FFFFFF"
                      BorderBrush="#3B82F6"
                      Click="OnPromptRunClick" />
            </StackPanel>
          </Grid>
        </Grid>

        <!-- Streaming / Preview / Error stage -->
        <Grid x:Name="PreviewPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path x:Name="PreviewLockIcon"
                    Data="{StaticResource LockIconGeometry}"
                    Width="11"
                    Height="11"
                    Stretch="None"
                    Stroke="#9CA3AF"
                    StrokeThickness="1.15"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    VerticalAlignment="Center"
                    Margin="0,0,5,0"
                    Visibility="Collapsed" />
              <TextBlock x:Name="PreviewActionText"
                         Foreground="#9CA3AF"
                         FontWeight="SemiBold"
                         FontSize="12"
                         VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="PreviewStatusText"
                       Grid.Column="1"
                       Foreground="#6B7280"
                       FontSize="11.5"
                       VerticalAlignment="Center" />
          </Grid>

          <Border x:Name="PreviewBoxBorder"
                  Grid.Row="1"
                  Background="#141419"
                  BorderBrush="#2A2A34"
                  BorderThickness="1"
                  CornerRadius="4"
                  SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="PreviewStreamingAccentBar"
                      Grid.Column="0"
                      Width="2"
                      Background="#2563EB"
                      CornerRadius="3,0,0,3"
                      Visibility="Collapsed" />
              <TextBox x:Name="PreviewBox"
                       Grid.Column="1"
                       Style="{StaticResource ReadOnlyOutputBoxStyle}"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" />
            </Grid>
          </Border>

          <TextBlock x:Name="ReadOnlyNoticeText"
                     Grid.Row="2"
                     Foreground="#9CA3AF"
                     FontSize="11.5"
                     Margin="0,6,0,0"
                     Visibility="Collapsed" />

          <TextBlock x:Name="ErrorText"
                     Grid.Row="3"
                     Foreground="#F87171"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Margin="0,6,0,0"
                     Visibility="Collapsed" />

          <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PreviewHintText"
                       Foreground="#6B7280"
                       FontSize="11"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
              <Button x:Name="SwitchListButton"
                      Padding="9,4"
                      Margin="0,0,6,0"
                      Background="#2A2A34"
                      Foreground="#93C5FD"
                      BorderBrush="#3B3B48"
                      Visibility="Collapsed"
                      Click="OnSwitchListButtonClick" />
              <Button x:Name="SecondaryActionButton"
                      Padding="9,4"
                      Margin="0,0,6,0"
                      Background="#2A2A34"
                      Foreground="#E5E7EB"
                      BorderBrush="#3B3B48"
                      Visibility="Collapsed"
                      Click="OnSecondaryActionButtonClick" />
              <Button x:Name="SecondaryButton"
                      Content="Back"
                      Padding="9,4"
                      Margin="0,0,6,0"
                      Background="#2A2A34"
                      Foreground="#E5E7EB"
                      BorderBrush="#3B3B48"
                      Click="OnSecondaryButtonClick" />
              <Button x:Name="PrimaryButton"
                      Content="Apply"
                      Padding="11,4"
                      Background="#2563EB"
                      Foreground="#FFFFFF"
                      BorderBrush="#3B82F6"
                      Click="OnPrimaryButtonClick" />
            </StackPanel>
          </Grid>
        </Grid>

        <!-- In-window searchable language picker overlay -->
        <Border x:Name="LanguagePickerOverlay"
                Background="#1A1B22"
                BorderBrush="#60A5FA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Visibility="Collapsed">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="Target language"
                       Foreground="#F3F4F6"
                       FontWeight="SemiBold"
                       FontSize="12.5"
                       Margin="0,0,0,6" />
            <TextBox x:Name="LanguageSearchBox"
                     Grid.Row="1"
                     Background="#121217"
                     Foreground="#F3F4F6"
                     CaretBrush="#F3F4F6"
                     BorderBrush="#3B3B48"
                     BorderThickness="1"
                     Padding="7,5"
                     Margin="0,0,0,6"
                     TextChanged="OnLanguageSearchTextChanged" />
            <ListBox x:Name="LanguageListBox"
                     Grid.Row="2"
                     Background="#121217"
                     Foreground="#E5E7EB"
                     BorderBrush="#2C2C36"
                     BorderThickness="1"
                     MouseDoubleClick="OnLanguageListDoubleClick"
                     PreviewMouseLeftButtonUp="OnLanguageListMouseUp" />
            <TextBlock Grid.Row="3"
                       Text="Up/Down select · Enter confirms · Esc cancels"
                       Foreground="#6B7280"
                       FontSize="11"
                       Margin="0,6,0,0" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
