<Window x:Class="Emendly.App.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emendly"
        Width="440"
        Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="True"
        Focusable="True"
        ShowInTaskbar="False"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Deactivated="OnWindowDeactivated"
        SizeChanged="OnWindowSizeChanged"
        FontFamily="Segoe UI"
        FontSize="13">
  <Border Background="#1E1E24"
          BorderBrush="#383846"
          BorderThickness="1"
          CornerRadius="10"
          Margin="8"
          Padding="12">
    <Border.Effect>
      <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.45" Color="#000000" />
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Mode line header -->
      <Grid Grid.Row="0" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="ModeLineText"
                   Foreground="#F9FAFB"
                   FontWeight="SemiBold"
                   FontSize="12.5"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Border Grid.Column="1"
                Background="#2A2A35"
                CornerRadius="4"
                Padding="6,2"
                Margin="8,0,0,0"
                VerticalAlignment="Center">
          <TextBlock x:Name="ModeBadgeText"
                     Foreground="#93C5FD"
                     FontSize="11"
                     FontWeight="Medium" />
        </Border>
      </Grid>

      <!-- Long selection notice (> 4,000 chars) -->
      <Border x:Name="LongSelectionBanner"
              Grid.Row="1"
              Background="#2B2518"
              BorderBrush="#6B531B"
              BorderThickness="1"
              CornerRadius="5"
              Padding="8,4"
              Margin="0,0,0,8"
              Visibility="Collapsed">
        <TextBlock Text="Long selection: first 4,000 characters used"
                   Foreground="#FCD34D"
                   FontSize="11.5" />
      </Border>

      <!-- Stage container -->
      <Grid Grid.Row="2">

        <!-- Unsupported stage -->
        <Grid x:Name="UnsupportedPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="4,0">
            <TextBlock Text="Unsupported"
                       Foreground="#F3F4F6"
                       FontSize="14"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="UnsupportedReasonText"
                       Foreground="#9CA3AF"
                       FontSize="12.5"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Esc closes"
                       Foreground="#6B7280"
                       FontSize="11"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="Close"
                    Padding="12,4"
                    Background="#2A2A34"
                    Foreground="#E5E7EB"
                    BorderBrush="#3B3B48"
                    Click="OnCloseButtonClick" />
          </Grid>
        </Grid>

        <!-- Action menu stage -->
        <Grid x:Name="MenuPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Filter bar (expanded view) -->
          <Border x:Name="FilterBar"
                  Grid.Row="0"
                  Background="#141419"
                  BorderBrush="#3B3B48"
                  BorderThickness="1"
                  CornerRadius="5"
                  Padding="8,4"
                  Margin="0,0,0,6"
                  Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="FilterText"
                         Foreground="#E5E7EB"
                         FontSize="12"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                         Text="Backspace clears · Left back"
                         Foreground="#6B7280"
                         FontSize="11"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>

          <!-- Item list (fixed flex slot inside fixed-height window) -->
          <ScrollViewer x:Name="ActionScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Focusable="False">
            <StackPanel x:Name="ActionListPanel"
                        Focusable="True"
                        FocusVisualStyle="{x:Null}" />
          </ScrollViewer>

          <!-- Options row (shown only when highlighted action has options) -->
          <Border x:Name="OptionsRowBorder"
                  Grid.Row="2"
                  Background="#171820"
                  BorderBrush="#2F3140"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="8,5"
                  Margin="0,6,0,0"
                  Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ContextChipButton"
                        Padding="8,3"
                        FontSize="11.5"
                        Background="#263148"
                        Foreground="#DBEAFE"
                        BorderBrush="#3B82F6"
                        Visibility="Collapsed"
                        Click="OnContextChipClick" />
                <Button x:Name="LanguageChipButton"
                        Padding="8,3"
                        FontSize="11.5"
                        Background="#263148"
                        Foreground="#DBEAFE"
                        BorderBrush="#3B82F6"
                        Visibility="Collapsed"
                        Click="OnLanguageChipClick" />
              </StackPanel>
              <TextBlock x:Name="OptionsHintText"
                         Grid.Column="1"
                         Foreground="#6B7280"
                         FontSize="11"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Margin="8,0,0,0"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>

          <!-- Context preview line (collapsed by default) -->
          <Border x:Name="ContextPreviewBorder"
                  Grid.Row="3"
                  Background="#141419"
                  BorderBrush="#2B2C38"
                  BorderThickness="1"
                  CornerRadius="5"
                  Padding="8,4"
                  Margin="0,5,0,0"
                  Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="ContextPreviewHeaderText"
                         Foreground="#9CA3AF"
                         FontSize="11"
                         TextTrimming="CharacterEllipsis"
                         Cursor="Hand"
                         MouseLeftButtonUp="OnContextPreviewToggleClick" />
              <TextBox x:Name="ContextPreviewBox"
                       Background="#101015"
                       Foreground="#D1D5DB"
                       BorderBrush="#2C2C36"
                       BorderThickness="1"
                       FontSize="11"
                       Padding="6,4"
                       Margin="0,4,0,0"
                       MaxHeight="74"
                       IsReadOnly="True"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       Visibility="Collapsed" />
            </StackPanel>
          </Border>

          <!-- Footer hints -->
          <TextBlock x:Name="MenuHintText"
                     Grid.Row="4"
                     Foreground="#6B7280"
                     FontSize="11"
                     Margin="2,6,0,0"
                     TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- Prompt input stage (Compose / Custom Prompt) -->
        <Grid x:Name="PromptPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock x:Name="PromptTitleText"
                     Grid.Row="0"
                     Foreground="#D1D5DB"
                     FontSize="12"
                     Margin="0,0,0,6" />

          <TextBox x:Name="PromptInputBox"
                   Grid.Row="1"
                   Background="#141419"
                   Foreground="#F3F4F6"
                   CaretBrush="#F3F4F6"
                   BorderBrush="#3B3B48"
                   BorderThickness="1"
                   Padding="8,7"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   AcceptsReturn="True" />

          <TextBlock x:Name="PromptErrorText"
                     Grid.Row="2"
                     Foreground="#F87171"
                     FontSize="11.5"
                     Margin="0,5,0,0"
                     Visibility="Collapsed" />

          <StackPanel x:Name="PromptContextSection"
                      Grid.Row="3"
                      Margin="0,8,0,0"
                      Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="PromptContextChipButton"
                      Padding="8,3"
                      FontSize="11.5"
                      Background="#263148"
                      Foreground="#DBEAFE"
                      BorderBrush="#3B82F6"
                      Click="OnContextChipClick" />
            </StackPanel>
            <Border x:Name="PromptContextPreviewBorder"
                    Background="#141419"
                    BorderBrush="#2B2C38"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8,4"
                    Margin="0,5,0,0"
                    Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="PromptContextPreviewHeaderText"
                           Foreground="#9CA3AF"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Cursor="Hand"
                           MouseLeftButtonUp="OnContextPreviewToggleClick" />
                <TextBox x:Name="PromptContextPreviewBox"
                         Background="#101015"
                         Foreground="#D1D5DB"
                         BorderBrush="#2C2C36"
                         BorderThickness="1"
                         FontSize="11"
                         Padding="6,4"
                         Margin="0,4,0,0"
                         MaxHeight="68"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Visibility="Collapsed" />
              </StackPanel>
            </Border>
          </StackPanel>

          <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Enter runs · Shift+Enter newline · Esc closes"
                       Foreground="#6B7280"
                       FontSize="11"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
              <Button Content="Back"
                      Padding="10,4"
                      Margin="0,0,6,0"
                      Background="#2A2A34"
                      Foreground="#E5E7EB"
                      BorderBrush="#3B3B48"
                      Click="OnPromptBackClick" />
              <Button Content="Run"
                      Padding="12,4"
                      Background="#2563EB"
                      Foreground="#FFFFFF"
                      BorderBrush="#3B82F6"
                      Click="OnPromptRunClick" />
            </StackPanel>
          </Grid>
        </Grid>

        <!-- Streaming / Preview / Error stage -->
        <Grid x:Name="PreviewPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PreviewActionText"
                       Foreground="#93C5FD"
                       FontWeight="SemiBold"
                       FontSize="12" />
            <TextBlock x:Name="PreviewStatusText"
                       Grid.Column="1"
                       Foreground="#9CA3AF"
                       FontSize="12" />
          </Grid>

          <TextBox x:Name="PreviewBox"
                   Grid.Row="1"
                   Background="#141419"
                   Foreground="#F3F4F6"
                   BorderBrush="#3B3B48"
                   BorderThickness="1"
                   Padding="8,7"
                   IsReadOnly="True"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" />

          <TextBlock x:Name="ReadOnlyNoticeText"
                     Grid.Row="2"
                     Foreground="#9CA3AF"
                     FontSize="11.5"
                     Margin="0,6,0,0"
                     Visibility="Collapsed" />

          <TextBlock x:Name="ErrorText"
                     Grid.Row="3"
                     Foreground="#F87171"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Margin="0,6,0,0"
                     Visibility="Collapsed" />

          <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PreviewHintText"
                       Foreground="#6B7280"
                       FontSize="11"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
              <Button x:Name="SwitchListButton"
                      Padding="9,4"
                      Margin="0,0,6,0"
                      Background="#2A2A34"
                      Foreground="#93C5FD"
                      BorderBrush="#3B3B48"
                      Visibility="Collapsed"
                      Click="OnSwitchListButtonClick" />
              <Button x:Name="SecondaryActionButton"
                      Padding="9,4"
                      Margin="0,0,6,0"
                      Background="#2A2A34"
                      Foreground="#E5E7EB"
                      BorderBrush="#3B3B48"
                      Visibility="Collapsed"
                      Click="OnSecondaryActionButtonClick" />
              <Button x:Name="SecondaryButton"
                      Content="Discard"
                      Padding="9,4"
                      Margin="0,0,6,0"
                      Background="#2A2A34"
                      Foreground="#E5E7EB"
                      BorderBrush="#3B3B48"
                      Click="OnSecondaryButtonClick" />
              <Button x:Name="PrimaryButton"
                      Content="Apply"
                      Padding="11,4"
                      Background="#2563EB"
                      Foreground="#FFFFFF"
                      BorderBrush="#3B82F6"
                      Click="OnPrimaryButtonClick" />
            </StackPanel>
          </Grid>
        </Grid>

        <!-- In-window searchable language picker overlay -->
        <Border x:Name="LanguagePickerOverlay"
                Background="#1A1B22"
                BorderBrush="#60A5FA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Visibility="Collapsed">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="Target language"
                       Foreground="#F3F4F6"
                       FontWeight="SemiBold"
                       FontSize="12.5"
                       Margin="0,0,0,6" />
            <TextBox x:Name="LanguageSearchBox"
                     Grid.Row="1"
                     Background="#121217"
                     Foreground="#F3F4F6"
                     CaretBrush="#F3F4F6"
                     BorderBrush="#3B3B48"
                     BorderThickness="1"
                     Padding="7,5"
                     Margin="0,0,0,6"
                     TextChanged="OnLanguageSearchTextChanged" />
            <ListBox x:Name="LanguageListBox"
                     Grid.Row="2"
                     Background="#121217"
                     Foreground="#E5E7EB"
                     BorderBrush="#2C2C36"
                     BorderThickness="1"
                     MouseDoubleClick="OnLanguageListDoubleClick"
                     PreviewMouseLeftButtonUp="OnLanguageListMouseUp" />
            <TextBlock Grid.Row="3"
                       Text="Up/Down select · Enter confirms · Esc cancels"
                       Foreground="#6B7280"
                       FontSize="11"
                       Margin="0,6,0,0" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
