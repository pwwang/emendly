<Window x:Class="Emendly.App.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emendly"
        Width="420"
        MaxHeight="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="True"
        Focusable="True"
        ShowInTaskbar="False"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Deactivated="OnWindowDeactivated"
        SizeChanged="OnWindowSizeChanged"
        FontFamily="Segoe UI"
        FontSize="13">
  <Border Background="#1E1E24"
          BorderBrush="#383846"
          BorderThickness="1"
          CornerRadius="10"
          Margin="8"
          Padding="12">
    <Border.Effect>
      <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.45" Color="#000000" />
    </Border.Effect>

    <StackPanel>
      <!-- Header -->
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Emendly"
                     Foreground="#F9FAFB"
                     FontWeight="SemiBold"
                     FontSize="13" />
          <TextBlock x:Name="HeaderMetaText"
                     Foreground="#9CA3AF"
                     FontSize="12"
                     Margin="8,1,0,0"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Border Grid.Column="1"
                Background="#2A2A35"
                CornerRadius="4"
                Padding="6,2"
                VerticalAlignment="Center">
          <TextBlock x:Name="ModeBadgeText"
                     Foreground="#93C5FD"
                     FontSize="11"
                     FontWeight="Medium" />
        </Border>
      </Grid>

      <!-- Action picker (Selection mode) -->
      <StackPanel x:Name="ActionPanel" Visibility="Collapsed">
        <StackPanel x:Name="ActionListPanel" Focusable="True" />
        <TextBlock Text="1-5 or Up/Down + Enter · Esc closes"
                   Foreground="#6B7280"
                   FontSize="11"
                   Margin="2,8,0,0" />
      </StackPanel>

      <!-- Compose prompt (Compose mode) -->
      <StackPanel x:Name="ComposePanel" Visibility="Collapsed">
        <TextBlock Text="What should Emendly write?"
                   Foreground="#D1D5DB"
                   FontSize="12"
                   Margin="0,0,0,6" />
        <TextBox x:Name="BriefBox"
                 Background="#141419"
                 Foreground="#F3F4F6"
                 CaretBrush="#F3F4F6"
                 BorderBrush="#3B3B48"
                 BorderThickness="1"
                 Padding="8,7"
                 MinHeight="64"
                 MaxHeight="130"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="False" />
        <CheckBox x:Name="UseContextCheckBox"
                  Foreground="#9CA3AF"
                  FontSize="12"
                  Margin="0,8,0,0"
                  IsChecked="True"
                  Visibility="Collapsed" />
        <TextBlock Text="Enter generates · Shift+Enter newline · Esc closes"
                   Foreground="#6B7280"
                   FontSize="11"
                   Margin="2,8,0,0" />
      </StackPanel>

      <!-- Streaming / Preview / Error -->
      <StackPanel x:Name="PreviewPanel" Visibility="Collapsed">
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="PreviewActionText"
                     Foreground="#93C5FD"
                     FontWeight="SemiBold"
                     FontSize="12" />
          <TextBlock x:Name="PreviewStatusText"
                     Grid.Column="1"
                     Foreground="#9CA3AF"
                     FontSize="12" />
        </Grid>

        <TextBox x:Name="PreviewBox"
                 Background="#141419"
                 Foreground="#F3F4F6"
                 BorderBrush="#3B3B48"
                 BorderThickness="1"
                 Padding="8,7"
                 MinHeight="72"
                 MaxHeight="220"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <TextBlock x:Name="ErrorText"
                   Foreground="#F87171"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   Visibility="Collapsed" />

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="PreviewHintText"
                     Foreground="#6B7280"
                     FontSize="11"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="SecondaryButton"
                    Content="Discard"
                    Padding="10,4"
                    Margin="0,0,6,0"
                    Background="#2A2A34"
                    Foreground="#E5E7EB"
                    BorderBrush="#3B3B48"
                    Click="OnSecondaryButtonClick" />
            <Button x:Name="PrimaryButton"
                    Content="Apply"
                    Padding="12,4"
                    Background="#2563EB"
                    Foreground="#FFFFFF"
                    BorderBrush="#3B82F6"
                    Click="OnPrimaryButtonClick" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
